# Image / REST
CONNECT_IMAGE=connector-cdc-service:1.0.0
CONNECT_HOST_PORT=8083
CONNECT_ADVERTISED_HOST_NAME=connector-cdc-service

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CONNECT_SECURITY_PROTOCOL=PLAINTEXT
CONNECT_GROUP_ID=connector-cdc-service
CONNECT_INTERNAL_REPLICATION_FACTOR=1

# Use 3 replicas (or the cluster standard) in production.
# CONNECT_INTERNAL_REPLICATION_FACTOR=3

# Worker runtime
KAFKA_HEAP_OPTS=-Xms512M -Xmx4G

# S3 / MinIO — inject secrets through the deployment secret manager.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
