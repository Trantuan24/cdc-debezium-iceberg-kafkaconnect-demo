{
  "name": "debezium-mongodb-source",
  "config": {

    "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
    "tasks.max": "1",

    "mongodb.connection.string": "mongodb://mongodb:27017/?replicaSet=rs0",

    "topic.prefix": "mongo",
    "database.include.list": "mydb_mongo",
    "collection.include.list": "mydb_mongo.products",

    "snapshot.mode": "initial",
    "capture.mode": "change_streams_update_full",

    "transforms": "unwrap,opMap,dropFields",
    "transforms.unwrap.type": "io.debezium.connector.mongodb.transforms.ExtractNewDocumentState",
    "transforms.unwrap.add.fields": "op",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.opMap.type": "com.example.smt.DebeziumOpMapper",
    "transforms.dropFields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.dropFields.exclude": "__deleted",

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter"
  }
}
