{
  "name": "debezium-oracle-source",
  "config": {

    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",

    "database.hostname": "oracle",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "dbz",
    "database.dbname": "XE",
    "database.pdb.name": "XEPDB1",

    "topic.prefix": "oracle",
    "schema.include.list": "DEBEZIUM",
    "table.include.list": "DEBEZIUM.TRANSACTIONS",

    "snapshot.mode": "initial",
    "decimal.handling.mode": "double",
    "database.connection.adapter": "logminer",
    "log.mining.strategy": "online_catalog",

    "schema.history.internal.kafka.bootstrap.servers": "kafka-cdc:9092",
    "schema.history.internal.kafka.topic": "schema-history.oracle.xepdb1",

    "transforms": "unwrap,opMap,dropFields",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.opMap.type": "com.example.smt.DebeziumOpMapper",
    "transforms.dropFields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.dropFields.exclude": "__deleted",

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter"
  }
}
