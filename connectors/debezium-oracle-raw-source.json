{
  "name": "debezium-oracle-raw-source",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "oracle",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "dbz",
    "database.dbname": "XE",
    "database.pdb.name": "XEPDB1",
    "topic.prefix": "raw.oracle",
    "schema.include.list": "DEBEZIUM",
    "table.include.list": "DEBEZIUM.TRANSACTIONS",
    "snapshot.mode": "initial",
    "decimal.handling.mode": "precise",
    "database.connection.adapter": "logminer",
    "log.mining.strategy": "online_catalog",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-cdc:9092",
    "schema.history.internal.kafka.topic": "schema-history.raw.oracle.xepdb1",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.decimal.format": "NUMERIC",
    "key.converter.schemas.enable": "true"
  }
}
